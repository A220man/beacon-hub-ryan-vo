# Beacon Hub Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to version control.

# Application
APP_NAME=beacon-hub
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite for local dev, PostgreSQL for Docker)
DATABASE_URL=sqlite+aiosqlite:///./beacon.db

# Security - CHANGE IN PRODUCTION
SECRET_KEY=dev-secret-change-in-production-must-be-32-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=beacon-hub
KEYCLOAK_CLIENT_ID=beacon-frontend
KEYCLOAK_CLIENT_SECRET=beacon-frontend-secret-change-in-production
OIDC_ISSUER=http://localhost:8080/realms/beacon-hub
OIDC_AUDIENCE=account

# LLM (optional - leave blank to disable AI explanations)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL (for Docker Compose)
POSTGRES_PASSWORD=beacon_dev_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password